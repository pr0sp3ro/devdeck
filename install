#!/usr/bin/env bash

set -euo pipefail

if [[ ${1:-} == -h || ${1:-} == --help ]]; then
    echo 'Usage: ./install'
    echo 'Build and install DevDeck in ~/.local/bin and create missing configuration.'
    exit 0
fi

if [[ $# -ne 0 ]]; then
    echo 'Usage: ./install' >&2
    exit 1
fi

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}

if [[ $config_home != /* ]]; then
    echo 'XDG_CONFIG_HOME must be an absolute path.' >&2
    exit 1
fi

project_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
bin_dir="$HOME/.local/bin"
config_dir="$config_home/devdeck"
config_file="$config_dir/config.toml"
build_dir=$(mktemp -d)

trap 'rm -rf -- "$build_dir"' EXIT

cd -- "$project_dir"
go build -o "$build_dir/devdeck" .

mkdir -p -- "$bin_dir"
install -m 755 -- "$build_dir/devdeck" "$bin_dir/devdeck"

mkdir -p -- "$config_dir"

if [[ ! -e $config_file && ! -L $config_file ]]; then
    (
        umask 077
        set -o noclobber
        cat > "$config_file" <<'EOF'
# Add project directories with: devdeck source add ~/src
sources = []

[projects]
EOF
    )

    echo "Created configuration: $config_file"
fi

echo "Installed DevDeck: $bin_dir/devdeck"
echo "Make sure $bin_dir is on your PATH."
